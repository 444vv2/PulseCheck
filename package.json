{
  "name": "pulsecheck",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pulsecheck/api",
    "build": "npm run build --workspace=@pulsecheck/api",
    "lint": "npm run lint --workspace=@pulsecheck/api",
    "test": "npm run test --workspace=@pulsecheck/api",
    "prisma:generate": "npm run prisma:generate --workspace=@pulsecheck/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@pulsecheck/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs/schedule": "^6.1.3",
    "axios": "^1.19.0",
    "stdlib": "^0.6.0"
  }
}
